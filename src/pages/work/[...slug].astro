---
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('work');
  return entries
    .filter((e) => !e.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);

const all = (await getCollection('work'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((e) => e.id === entry.id);
const next = all[(index + 1) % all.length];
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="page casehead">
      <p class="meta">
        <a href="/work">Work</a> &nbsp;&rarr;&nbsp; {entry.data.org}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="lede casehead__tagline">{entry.data.tagline}</p>

      <dl class="facts">
        <div>
          <dt class="label">Role</dt>
          <dd>{entry.data.role}</dd>
        </div>
        <div>
          <dt class="label">Organisation</dt>
          <dd>{entry.data.org}</dd>
        </div>
        <div>
          <dt class="label">Years</dt>
          <dd>{entry.data.years}</dd>
        </div>
      </dl>
    </header>

    <div class="page casehero">
      <Frame src={entry.data.cover} alt={entry.data.coverAlt ?? ''} ratio="16 / 9" />
    </div>

    <div class="page prose">
      <Content />
    </div>

    {
      entry.data.links.length > 0 && (
        <div class="page section">
          <p class="label">See it live</p>
          <ul class="outlinks">
            {entry.data.links.map((l) => (
              <li>
                <a href={l.href} rel="noopener">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <nav class="page section nextcase" aria-label="Next case study">
      <a href={`/work/${next.id}`}>
        <p class="label">Next</p>
        <p class="nextcase__title mono">{next.data.title}</p>
      </a>
    </nav>
  </article>
</Base>

<style>
  .casehead {
    padding-block-start: clamp(1.25rem, 4vw, 3rem);
  }

  .casehead h1 {
    margin-block-start: 0.85rem;
    font-size: clamp(2.1rem, 5.2vw, 3.6rem);
  }

  .casehead__tagline {
    margin-block-start: 1rem;
    max-width: 48ch;
  }

  .facts {
    display: grid;
    gap: 1.25rem 2.5rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule);
  }

  @media (min-width: 40rem) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .facts dd {
    margin: 0.35rem 0 0;
  }

  .casehero {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
  }

  /* --- Long-form body --------------------------------------------- */

  .prose {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
  }

  .prose :global(h2) {
    font-size: clamp(1.3rem, 1.05rem + 1vw, 1.75rem);
    margin-block-start: clamp(2.25rem, 5vw, 3.25rem);
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule-soft);
  }

  .prose :global(h2:first-child) {
    margin-block-start: 0;
    padding-block-start: 0;
    border: 0;
  }

  .prose :global(p) {
    margin-block-start: 1.1rem;
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  /* --- Outbound links --------------------------------------------- */

  .outlinks {
    margin-block-start: 1rem;
    border-block-start: 1px solid var(--rule);
  }

  .outlinks li {
    border-block-end: 1px solid var(--rule-soft);
  }

  .outlinks a {
    display: block;
    padding-block: 0.95rem;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 0.92rem + 0.2vw, 1.05rem);
  }

  .outlinks a::after {
    content: ' ↗';
  }

  .outlinks a:hover {
    text-decoration: underline;
  }

  /* --- Next ------------------------------------------------------- */

  .nextcase a {
    display: block;
    padding-block: 1.75rem;
    border-block-start: 1px solid var(--rule);
    text-decoration: none;
  }

  .nextcase__title {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.4rem);
    margin-block-start: 0.5rem;
  }

  .nextcase a:hover .nextcase__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
