---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Frame from '../../components/Frame.astro';
import { getCollection } from 'astro:content';

const work = (await getCollection('work'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Work"
  description="Design systems, product design and editing tools — Wikimedia, Domestika, Bankinter and earlier client work."
>
  <PageHead eyebrow="Work" title="Systems, and the products they hold up.">
    <p class="lede">
      Ten years of design work, mostly on the parts people never notice until they break:
      the components, the tokens, the rules underneath the interface.
    </p>
  </PageHead>

  <div class="page">
    <ul class="cases">
      {
        work.map((entry) => (
          <li class="case">
            <a class="case__link" href={`/work/${entry.id}`}>
              <div class="case__thumb">
                <Frame
                  src={entry.data.cover}
                  alt={entry.data.coverAlt ?? ''}
                  ratio="16 / 10"
                />
              </div>
              <div class="case__text">
                <p class="meta">
                  {entry.data.org} &middot; {entry.data.years}
                </p>
                <h2 class="case__title">{entry.data.title}</h2>
                <p class="case__tagline">{entry.data.tagline}</p>
                <p class="case__summary">{entry.data.summary}</p>
                <p class="meta case__cta">Read the case &rarr;</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .cases {
    padding-block-start: 1rem;
  }

  .case + .case {
    border-block-start: 1px solid var(--rule-soft);
  }

  .case__link {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    padding-block: clamp(2rem, 4.5vw, 3rem);
    text-decoration: none;
  }

  @media (min-width: 48rem) {
    .case__link {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 3rem;
    }
  }

  .case__link:hover {
    opacity: 1;
  }

  .case__link:hover .case__title {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .case__title {
    font-family: var(--font-mono);
    font-size: clamp(1.45rem, 1.1rem + 1.2vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-block-start: 0.5rem;
  }

  .case__tagline {
    margin-block-start: 0.6rem;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.18rem);
  }

  .case__summary {
    margin-block-start: 0.9rem;
  }

  .case__cta {
    margin-block-start: 1.1rem;
  }
</style>
