---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Frame from '../../components/Frame.astro';
import ExtLink from '../../components/ExtLink.astro';
import { getCollection } from 'astro:content';

const work = (await getCollection('work'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Work"
  description="Design systems and product design — Wikimedia, Domestika, Bankinter and earlier client work."
>
  <PageHead eyebrow="Work" title="Design systems and products I’ve worked on.">
    <p class="lede">
      A selection from the last ten years working for different design systems and
      product design for clients of different sectors.
    </p>
  </PageHead>

  <div class="page">
    <ul class="cases">
      {
        work.map((entry) => (
          <li class="case">
            <div class="case__text">
              <p class="meta">
                {entry.data.org} &middot; {entry.data.years}
              </p>
              <h2 class="case__title">{entry.data.title}</h2>
              <p class="case__tagline">{entry.data.tagline}</p>
              <p class="case__summary">{entry.data.summary}</p>

              {entry.data.links.length > 0 && (
                <p class="meta outlinks extlinks">
                  {entry.data.links.map((l) => <ExtLink href={l.href}>{l.label}</ExtLink>)}
                </p>
              )}
            </div>

            <div class="case__thumb">
              <Frame
                src={entry.data.cover}
                alt={entry.data.coverAlt ?? ''}
                ratio="16 / 10"
              />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .cases {
    padding-block-start: 1rem;
  }

  .case {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    padding-block: clamp(2rem, 4.5vw, 3rem);
  }

  .case + .case {
    border-block-start: 1px solid var(--rule-soft);
  }

  @media (min-width: 48rem) {
    .case {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 3rem;
    }
  }

  .case__title {
    font-family: var(--font-mono);
    font-size: clamp(1.45rem, 1.1rem + 1.2vw, 2.1rem);
    margin-block-start: 0.5rem;
  }

  .case__tagline {
    margin-block-start: 0.6rem;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.18rem);
  }

  .case__summary {
    margin-block-start: 0.9rem;
  }


  .outlinks {
    margin-block-start: 1.25rem;
  }




</style>
