---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import { getCollection } from 'astro:content';
import { links } from '../data/site';

// The home shows only the current Wikimedia work; /work has the rest.
const work = (await getCollection('work'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const writing = (await getCollection('writing'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

const illos = (await getCollection('gallery'))
  .filter((e) => e.data.section === 'illustration')
  .sort((a, b) => a.data.order - b.data.order);

// Where each piece of work can be seen. The earlier client work is under
// agreement, so it gets a description instead of a link.
const seeIt: Record<string, { label: string; href: string }[]> = {
  codex: [{ label: 'Codex demo site', href: 'https://doc.wikimedia.org/codex/latest/' }],
  'edit-check': [
    { label: 'Edit Check', href: 'https://www.mediawiki.org/wiki/Help:Edit_check' },
    {
      label: 'Suggestion Mode',
      href: 'https://www.mediawiki.org/wiki/VisualEditor/Suggestion_Mode',
    },
  ],
  'design-systems-before-wikimedia': [
    { label: 'Domestika', href: 'https://www.domestika.org/' },
    { label: 'Bankinter', href: 'https://www.bankinter.com/' },
  ],
};

const instead: Record<string, string> = {
  'product-design':
    'Web and app projects for online banking, food, events and tools for a regional government, among others.',
};
---

<Base>
  <!-- Hero -->
  <section class="page hero">
    <h1>Hola! I&rsquo;m Bárbara Martínez</h1>

    <div class="flow hero__body">
      <p class="lede">
        I&rsquo;m a product designer based in Madrid, currently working at the{' '}
        <a href="https://wikimediafoundation.org/">Wikimedia Foundation</a> on the{' '}
        <a href="https://www.mediawiki.org/wiki/Editing_team">Editing team</a>.
      </p>
      <p>
        I design products and systems that make complexity feel simple. With expertise in
        design systems, accessibility and internationalization, I focus on creating
        inclusive tools that help teams scale and make technology more human.
      </p>
      <p class="quote">Tools change. Intention doesn&rsquo;t.</p>
    </div>
  </section>

  <!-- Selected work -->
  <section class="page section">
    <div class="head-row">
      <h2 id="work-heading">Selected work</h2>
      <a class="meta head-row__more" href="/work" aria-label="View more work">View more <span aria-hidden="true">→</span></a>
    </div>

    <ul class="cases" aria-labelledby="work-heading">
      {
        work.map((entry) => (
          <li class="case">
            <div class="case__head">
              <h3 class="case__title">{entry.data.title}</h3>
              <p class="meta case__meta">
                {entry.data.org} &middot; {entry.data.years}
              </p>
            </div>

            <div class="case__body">
              <p class="case__tagline">{entry.data.tagline}</p>

              {instead[entry.id] && <p class="case__note">{instead[entry.id]}</p>}

              {seeIt[entry.id] && (
                <p class="meta case__links linkrow">
                  {seeIt[entry.id].map((l) => (
                    <a href={l.href} rel="noopener">
                      {l.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Writing & talks -->
  <section class="page section">
    <div class="head-row">
      <h2 id="writing-heading">Selected talks</h2>
      <a class="meta head-row__more" href="/writing" aria-label="View more talks and writing">View more <span aria-hidden="true">→</span></a>
    </div>

    <ul class="notes" aria-labelledby="writing-heading">
      {
        writing.map((entry) => (
          <li class="note">
            <p class="meta note__where">
              <span class="pill">{entry.data.kind}</span>
              <span>
                {entry.data.venue}
                {entry.data.lang !== 'English' && <span> &middot; in {entry.data.lang}</span>}
              </span>
            </p>
            <p class="note__title">
              <a
                href={entry.data.href}
                rel="noopener"
                lang={entry.data.lang === 'Spanish' ? 'es' : undefined}
              >
                {entry.data.title} <span aria-hidden="true">↗</span>
              </a>
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Illustrations -->
  <section class="page section">
    <div class="head-row">
      <h2 id="illo-heading">Illustrations</h2>
      <a class="meta head-row__more" href="/illustration" aria-label="View more illustrations">View more <span aria-hidden="true">→</span></a>
    </div>

    <p class="intro">
      I studied Fine Arts before working as a product designer, and I never stopped
      drawing. Prints, cards and commissions, made as{' '}
      <a href={links.instagram} rel="noopener">Be Mart</a>.
    </p>

    <div class="strip" role="region" aria-labelledby="illo-heading" tabindex="0">
      <ul>
        {
          illos.map((p) => (
            <li>
              <Frame
                src={p.data.image}
                alt={p.data.alt ?? p.data.title}
                ratio={p.data.ratio}
              />
            </li>
          ))
        }
      </ul>
    </div>

  </section>
</Base>

<style>
  .hero {
    padding-block-start: clamp(2rem, 6vw, 5rem);
  }

  .hero__body {
    margin-block-start: clamp(1.75rem, 4vw, 2.75rem);
  }

  .hero .quote {
    margin-block-start: 2rem;
  }

  /* --- Section heads ---------------------------------------------- */

  .head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: 1.25rem;
    border-block-end: 1px solid var(--rule);
  }

  .head-row__more {
    flex: none;
    text-decoration: none;
    white-space: nowrap;
  }

  .head-row__more:hover {
    text-decoration: underline;
  }

  .intro {
    margin-block-start: 1.5rem;
  }

  /* --- Cases: text only ------------------------------------------- */

  .case {
    display: grid;
    gap: 0.75rem;
    align-items: start;
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
  }

  .case + .case {
    border-block-start: 1px solid var(--rule-soft);
  }

  @media (min-width: 52rem) {
    .case {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: 3rem;
    }
  }

  .case__title {
    font-family: var(--font-mono);
    font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .case__meta {
    margin-block-start: 0.5rem;
  }

  .case__tagline {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.18rem);
  }

  .case__note {
    margin-block-start: 0.65rem;
  }

  .case__links {
    margin-block-start: 1rem;
  }

  .case__links a {
    border-block-end: 1px solid var(--rule);
  }

  /* The border under these links is the affordance, so hover darkens it
     instead of adding a second underline on top. */
  .case__links a:hover {
    text-decoration: none;
    border-block-end-color: currentColor;
  }

  /* --- Notes ------------------------------------------------------ */

  .note {
    padding-block: 1.25rem;
    display: grid;
    gap: 0.35rem;
  }

  .note + .note {
    border-block-start: 1px solid var(--rule-soft);
  }

  @media (min-width: 52rem) {
    .note {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      gap: 2rem;
      align-items: baseline;
    }
  }

  .note__where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
  }

  .note__title {
    font-family: var(--font-mono);
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.22rem);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .note__title a {
    text-decoration: none;
  }

  .note__title a:hover {
    text-decoration: underline;
  }

  /* --- Illustration strip ------------------------------------------
     A scroll-snapping row rather than a carousel: no JavaScript, it
     scrolls with a trackpad, a finger or the arrow keys, and it never
     hides a piece behind a "next" button. */

  .strip {
    margin-block-start: clamp(1.75rem, 4vw, 2.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--rule) transparent;
    padding-block-end: 1rem;
  }

  .strip:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .strip ul {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    width: max-content;
  }

  .strip li {
    flex: 0 0 clamp(11rem, 26vw, 16rem);
    scroll-snap-align: start;
  }

</style>
