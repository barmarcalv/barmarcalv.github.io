---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import { getCollection } from 'astro:content';
import { links } from '../data/site';

const work = (await getCollection('work'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const writing = (await getCollection('writing'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

const illos = (await getCollection('gallery'))
  .filter((e) => e.data.section === 'illustration')
  .sort((a, b) => a.data.order - b.data.order);

const systems = [
  { org: 'Bankinter', what: 'A bank', years: '2018 — 2020' },
  { org: 'Domestika', what: 'A creative marketplace', years: '2021' },
  { org: 'Wikimedia', what: 'An open encyclopedia', years: '2021 — 2025' },
];

// An extra link for the one case that has a public demo.
const demo: Record<string, { label: string; href: string }> = {
  codex: { label: 'Open the Codex demo', href: 'https://doc.wikimedia.org/codex/latest/' },
};
---

<Base>
  <!-- Hero -->
  <section class="page hero">
    <h1>Hola! I&rsquo;m Bárbara Martínez</h1>

    <div class="flow hero__body">
      <p class="lede">
        I&rsquo;m a product designer based in Madrid, currently working at the{' '}
        <a href="https://wikimediafoundation.org/">Wikimedia Foundation</a> on the{' '}
        <a href="https://www.mediawiki.org/wiki/Editing_team">Editing team</a>.
      </p>
      <p>
        I design products and systems that make complexity feel simple. With expertise in
        design systems, accessibility and internationalization, I focus on creating
        inclusive tools that help teams scale and make technology more human.
      </p>
      <p class="quote">Tools change. Intention doesn&rsquo;t.</p>
    </div>
  </section>

  <!-- Design systems -->
  <section class="page section">
    <div class="head-row">
      <h2>Design systems</h2>
    </div>

    <p class="thesis__body">
      A bank. A creative learning marketplace. An encyclopedia written by volunteers in
      more than 300 languages. Same craft each time and almost nothing else in common —
      which turns out to be the fastest way to learn what a design system really is
      underneath the components.
    </p>

    <ul class="systems">
      {
        systems.map((s) => (
          <li class="systems__item">
            <p class="systems__org mono">{s.org}</p>
            <p class="systems__what">{s.what}</p>
            <p class="meta">{s.years}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Selected work -->
  <section class="page section">
    <div class="head-row">
      <h2 id="work-heading">Selected work</h2>
      <a class="meta head-row__more" href="/work">View more &rarr;</a>
    </div>

    <ul class="cases" aria-labelledby="work-heading">
      {
        work.map((entry) => (
          <li class="case">
            <div class="case__text">
              <h3 class="case__title">{entry.data.title}</h3>
              <p class="case__tagline">{entry.data.tagline}</p>
              <p class="meta case__meta">
                {entry.data.org} &middot; {entry.data.years}
              </p>
              {demo[entry.id] && (
                <p class="meta case__demo">
                  <a href={demo[entry.id].href} rel="noopener">
                    {demo[entry.id].label} &nearr;
                  </a>
                </p>
              )}
            </div>
            <div class="case__thumb">
              <Frame
                src={entry.data.cover}
                alt={entry.data.coverAlt ?? ''}
                ratio="16 / 10"
              />
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Writing & talks -->
  <section class="page section">
    <div class="head-row">
      <h2 id="writing-heading">Writing &amp; Talks</h2>
      <a class="meta head-row__more" href="/writing">View more &rarr;</a>
    </div>

    <ul class="notes" aria-labelledby="writing-heading">
      {
        writing.map((entry) => (
          <li class="note">
            <p class="meta note__kind">{entry.data.kind}</p>
            <p class="note__title">
              <a href={entry.data.href} rel="noopener">
                {entry.data.title}
              </a>
            </p>
            <p class="meta">{entry.data.venue}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Illustrations -->
  <section class="page section">
    <div class="head-row">
      <h2 id="illo-heading">Illustrations</h2>
      <a class="meta head-row__more" href="/illustration">View more &rarr;</a>
    </div>

    <p class="thesis__body">
      I studied Fine Arts before I studied design, and I never stopped drawing. Prints,
      cards and commissions, made as Be Mart.
    </p>

    <div
      class="strip"
      role="region"
      aria-labelledby="illo-heading"
      tabindex="0"
    >
      <ul>
        {
          illos.map((p) => (
            <li>
              <Frame
                src={p.data.image}
                alt={p.data.alt ?? p.data.title}
                ratio={p.data.ratio}
              />
            </li>
          ))
        }
      </ul>
    </div>

    <p class="meta strip__links">
      <a href={links.instagram} rel="noopener">Latest on Instagram &nearr;</a>
    </p>
  </section>
</Base>

<style>
  .hero {
    padding-block-start: clamp(2rem, 6vw, 5rem);
  }

  .hero__body {
    margin-block-start: clamp(1.75rem, 4vw, 2.75rem);
  }

  .hero .quote {
    margin-block-start: 2rem;
  }

  /* --- Section heads ---------------------------------------------- */

  .head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: 1.25rem;
    border-block-end: 1px solid var(--rule);
  }

  .head-row__more {
    flex: none;
    text-decoration: none;
    white-space: nowrap;
  }

  .head-row__more:hover {
    text-decoration: underline;
  }

  .thesis__body {
    margin-block-start: 1.5rem;
  }

  /* --- Three systems ---------------------------------------------- */

  .systems {
    display: grid;
    gap: 1px;
    margin-block-start: clamp(2rem, 5vw, 3.25rem);
    background: var(--rule);
    border-block: 1px solid var(--rule);
  }

  @media (min-width: 45rem) {
    .systems {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .systems__item {
    background: var(--paper);
    padding: 1.35rem 0;
  }

  @media (min-width: 45rem) {
    .systems__item {
      padding: 1.5rem 1.5rem 1.5rem 0;
    }
    .systems__item + .systems__item {
      padding-inline-start: 1.5rem;
    }
  }

  .systems__org {
    font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .systems__what {
    margin-block-start: 0.2rem;
  }

  .systems__item .meta {
    margin-block-start: 0.35rem;
  }

  /* --- Cases ------------------------------------------------------ */

  .case {
    display: grid;
    gap: 1.25rem;
    align-items: start;
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
  }

  .case + .case {
    border-block-start: 1px solid var(--rule-soft);
  }

  @media (min-width: 45rem) {
    .case {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  .case__title {
    font-family: var(--font-mono);
    font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .case__tagline {
    margin-block-start: 0.5rem;
  }

  .case__meta {
    margin-block-start: 0.75rem;
  }

  .case__demo {
    display: inline-block;
    margin-block-start: 0.85rem;
  }

  .case__demo a {
    text-decoration: none;
    border-block-end: 1px solid var(--rule);
    padding-block-end: 0.15rem;
  }

  .case__demo a:hover {
    border-block-end-color: currentColor;
  }

  .case__thumb {
    order: -1;
  }

  @media (min-width: 45rem) {
    .case__thumb {
      order: 0;
    }
  }

  /* --- Notes ------------------------------------------------------ */

  .note {
    padding-block: 1.25rem;
  }

  .note + .note {
    border-block-start: 1px solid var(--rule-soft);
  }

  @media (min-width: 45rem) {
    .note {
      display: grid;
      grid-template-columns: 7rem minmax(0, 1fr) minmax(0, 14rem);
      gap: 1.5rem;
      align-items: baseline;
    }
  }

  .note__title {
    font-size: clamp(1.02rem, 0.98rem + 0.3vw, 1.18rem);
    font-weight: 500;
  }

  .note__title a {
    text-decoration: none;
  }

  .note__title a:hover {
    text-decoration: underline;
  }

  .note__kind {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* --- Illustration strip -----------------------------------------
     A scroll-snapping row rather than a carousel: no JavaScript, it
     scrolls with a trackpad, a finger or the arrow keys, and it never
     hides a piece behind a "next" button. */

  .strip {
    margin-block-start: clamp(1.75rem, 4vw, 2.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--rule) transparent;
    padding-block-end: 1rem;
  }

  .strip:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .strip ul {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    width: max-content;
  }

  .strip li {
    flex: 0 0 clamp(11rem, 26vw, 16rem);
    scroll-snap-align: start;
  }

  .strip__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-block-start: 1rem;
  }

  .strip__links a {
    text-decoration: none;
  }

  .strip__links a:hover {
    text-decoration: underline;
  }
</style>
