---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import { links } from '../data/site';

---

<Base
  title="About"
  description="Bárbara Martínez Calvo — senior product designer in Madrid, working on design systems, accessibility and internationalization at the Wikimedia Foundation."
>
  <div class="page about">
    <div class="about__portrait">
      <Frame
        src="/img/about/barbara.webp"
        alt="Bárbara Martínez, looking off to one side"
        ratio="4 / 5"
      />
    </div>

    <div class="about__text">
      <p class="label">About</p>
      <h1>A designer who came in through the art school door.</h1>

      <div class="flow about__body">
        <p>
          I&rsquo;m a senior product designer based in Madrid. For the last five years
          I&rsquo;ve been at the{' '}
          <a href="https://wikimediafoundation.org/" rel="noopener">Wikimedia Foundation</a>,
          where I helped build <a href="/work">Codex</a> — the design system behind
          Wikipedia in more than 300 languages — and where I now work on the tools people
          use to edit it.
        </p>
        <p>
          I studied{' '}
          <a href="https://usal.es/" rel="noopener">Fine Arts</a> before I studied design,
          and that&rsquo;s still how I work: composition and colour first, components
          after. It&rsquo;s probably why I ended up in design systems — I like building
          the thing underneath. Most of what I build is open source, used across hundreds
          of languages, and made so teams can keep growing it without me.
        </p>
        <p>
          Before Wikimedia I worked across a lot of sectors — online banking, automotive,
          food, education, events, public sector — on web and on apps, and then on design
          systems for banking and online education.
        </p>
        <p>
          Accessibility and internationalization are what I care about most. A component
          that works in Arabic, in German, with a screen reader and with a keyboard is
          simply better for everyone. That&rsquo;s the work I want to keep doing:
          inclusive tools that make technology feel a bit more human.
        </p>
        <p>
          Outside work I draw, and sell the results as{' '}
          <a href="/illustration">Be Mart</a>.
        </p>
      </div>

      <p class="meta about__cv linkrow">
        <a href={links.linkedin} rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
      </p>
    </div>
  </div>

</Base>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-block-start: clamp(1.5rem, 5vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 52rem) {
    .about {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }
    .about__portrait {
      position: sticky;
      top: 2.5rem;
    }
  }

  .about h1 {
    font-size: clamp(1.85rem, 1.3rem + 2vw, 2.9rem);
    margin-block-start: 0.6rem;
  }

  .about__body {
    margin-block-start: clamp(1.5rem, 3vw, 2.25rem);
  }

  .about__cv {
    margin-block-start: 2rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule);
  }

</style>
