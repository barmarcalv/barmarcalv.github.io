---
import Monogram from './Monogram.astro';

const links = [
  { href: '/work', label: 'Work' },
  { href: '/writing', label: 'Writing & Talks' },
  { href: '/illustration', label: 'Illustration' },
  { href: '/other-work', label: 'Other work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="masthead">
  <div class="page masthead__inner">
    <a href="/" class="masthead__mark" aria-label="Bárbara Martínez — home">
      <Monogram />
    </a>

    <button
      class="masthead__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Menu"
      data-nav-toggle
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <g
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          fill="none"
        >
          <path class="icon-bars" d="M3 6h18M3 12h18M3 18h18"></path>
          <path class="icon-close" d="M5.5 5.5l13 13M18.5 5.5l-13 13"></path>
        </g>
      </svg>
    </button>

    <nav id="site-menu" class="masthead__nav" aria-label="Main">
      <ul>
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .masthead {
    padding-block: clamp(1.5rem, 4vw, 2.75rem);
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .masthead__mark {
    flex: none;
    text-decoration: none;
  }

  /* Icon-only on small screens. The square keeps a 44px touch target
     even though the glyph inside is 24px. */
  .masthead__toggle {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-inline-end: -0.6rem;
    color: var(--ink);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .masthead__toggle svg {
    inline-size: 1.5rem;
    block-size: 1.5rem;
  }

  .masthead__toggle .icon-close {
    display: none;
  }

  .masthead__toggle[aria-expanded='true'] .icon-bars {
    display: none;
  }

  .masthead__toggle[aria-expanded='true'] .icon-close {
    display: inline;
  }

  .masthead__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem clamp(1rem, 2.4vw, 2rem);
  }

  .masthead__nav a {
    font-size: clamp(1rem, 0.96rem + 0.18vw, 1.08rem);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-block-size: 1.75rem;
  }

  .masthead__nav a:hover {
    text-decoration: underline;
  }

  .masthead__nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.3em;
  }

  /* Mobile: collapse behind the Menu button. */
  @media (max-width: 47.99rem) {
    .masthead__nav {
      flex-basis: 100%;
      display: none;
    }
    .masthead__nav[data-open] {
      display: block;
      padding-block-start: 0.5rem;
    }
    .masthead__nav ul {
      flex-direction: column;
      gap: 0.15rem;
    }
    .masthead__nav a {
      padding-block: 0.45rem;
    }
  }

  @media (min-width: 48rem) {
    .masthead__toggle {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.getElementById('site-menu');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (open) {
      menu?.removeAttribute('data-open');
    } else {
      menu?.setAttribute('data-open', '');
    }
  });
</script>
