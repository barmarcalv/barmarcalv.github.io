---
import { links } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="page foot__inner">
    <p class="meta foot__rights">© {year} Bárbara Martínez</p>
    <ul class="foot__links linkrow meta">
      <li><a href={`mailto:${links.email}`}>Email</a></li>
      <li><a href={links.linkedin} target="_blank" rel="me noopener noreferrer">LinkedIn<span class="visually-hidden">(opens in a new tab)</span></a></li>
      <li><a href={links.github} target="_blank" rel="me noopener noreferrer">GitHub<span class="visually-hidden">(opens in a new tab)</span></a></li>
      <li><a href={links.instagram} target="_blank" rel="me noopener noreferrer">Instagram<span class="visually-hidden">(opens in a new tab)</span></a></li>
    </ul>
  </div>
</footer>

<style>
  .foot {
    margin-block-start: var(--section-gap);
    border-block-start: 1px solid var(--rule);
    padding-block: 2rem 3rem;
  }

  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

</style>
