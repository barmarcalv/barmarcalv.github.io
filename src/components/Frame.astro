---
/**
 * Images are shown as they were made — no filter, no tint.
 * With no `src` it renders a neutral placeholder of the right proportion,
 * so a layout can be built before the artwork exists.
 */
interface Props {
  src?: string;
  alt?: string;
  ratio?: string;
  caption?: string;
}

const { src, alt = '', ratio = '4 / 3', caption } = Astro.props;
---

<figure class="frame">
  <div class="frame__box" style={`aspect-ratio:${ratio}`}>
    {src && <img src={src} alt={alt} loading="lazy" decoding="async" />}
  </div>
  {caption && <figcaption class="meta">{caption}</figcaption>}
</figure>

<style>
  .frame {
    margin: 0;
  }

  .frame__box {
    position: relative;
    overflow: hidden;
    background: var(--placeholder);
    border-radius: 2px;
  }

  .frame__box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    margin-block-start: 0.6rem;
  }
</style>
